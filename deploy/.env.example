# Змінні для compose.yaml. Скопіюйте в .env поруч і заповніть; у панелях
# керування задайте їх як змінні стека.

# Версія образу ghcr.io/prro-cloud/prro-mcp — без "v": тег v0.2.0 → 0.2.0.
PRRO_MCP_VERSION=0.2.0

# Адреса, на якій хост публікує сервер для зворотного проксі: loopback, якщо
# проксі на цьому ж хості, або приватна адреса, якщо на іншому. Не 0.0.0.0.
PRRO_MCP_PUBLISH=127.0.0.1:8080

# Необов'язкові — значення за замовчуванням.
# PRRO_MCP_IMAGE=ghcr.io/prro-cloud/prro-mcp
# PRRO_BASE_URL=https://api.prro.cloud
# PRRO_LANG=uk
# PRRO_MCP_LOG_LEVEL=info
# PRRO_MCP_RATE_LIMIT=120
# PRRO_MCP_MEMORY=128M
